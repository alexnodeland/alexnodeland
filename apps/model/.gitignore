# Generated by the pipeline; regenerated from the site in seconds.
data/
# Every training run: adapters, exports, metrics, evals. Published runs go
# to GitHub releases, and one snapshot is committed under models/.
runs/
# MLflow's local file store (`just model ui` to browse it).
mlruns/
# The base checkpoint (90MB, from Hugging Face) and the engine cache.
checkpoints/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Augmentation runs write their log beside the generations; the generations are tracked, the log is not.
augment/*.log
