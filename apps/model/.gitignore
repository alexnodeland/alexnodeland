# Generated by the pipeline; regenerated from the site in seconds.
data/
# Every training run: adapters, exports, metrics, evals, the eval cache and
# compare tables. Published runs go to the Hugging Face Hub; models/ holds
# the pointer the site builds against, and `site-needle pull` materialises
# the rest beside it.
runs/
models/*
!models/site-needle.json
# MLflow's local file store (`just model ui` to browse it).
mlruns/
# The base checkpoint (90MB, from Hugging Face) and the engine cache.
checkpoints/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Augmentation runs write their log beside the generations; the generations are tracked, the log is not.
augment/*.log
